generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  SHOP_OWNER
  RIDER
  ADMIN
}

enum ShopStatus {
  PENDING
  APPROVED
  REJECTED
}

enum RiderVerificationStatus {
  PENDING
  ACTIVE
  REJECTED
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED_CONFIRMED
  AWAITING_SHOP_CONFIRMATION
  SHOP_ACCEPTED
  SHOP_REJECTED
  PREPARING
  READY_FOR_PICKUP
  OFFERING_TO_RIDER
  NO_RIDER_AVAILABLE
  CANCELLED_BY_ADMIN
  CANCELLED_BY_CUSTOMER
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  COMPLETED
  REFUNDING
  REFUNDED
  PAYMENT_FAILED
}

enum DeliveryAssignmentStatus {
  OFFERING
  ACCEPTED
  RIDER_EN_ROUTE_TO_SHOP
  PICKED_UP
  OUT_FOR_DELIVERY
  DELIVERED
  DELIVERY_FAILED
  ADMIN_REVIEW
  NO_RIDER_AVAILABLE
  CANCELLED
}

enum DeliveryOfferStatus {
  PENDING
  ACCEPTED
  REJECTED
  EXPIRED
}

enum PaymentMethod {
  COD
}

enum PaymentStatus {
  PENDING
  COLLECTED
  FAILED
  CANCELLED
}

enum RefundStatus {
  PENDING
  PROCESSED
}

model User {
  id           String   @id @default(uuid())
  fullName     String
  phone        String   @unique
  email        String   @unique
  passwordHash String
  role         Role
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  addresses     Address[]
  shop          Shop?
  riderProfile  RiderProfile?
  ordersPlaced  Order[]              @relation("CustomerOrders")
  notifications Notification[]
  reviews       Review[]
  statusChanges OrderStatusHistory[]

  @@map("users")
}

model Address {
  id        String  @id @default(uuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  latitude  Decimal
  longitude Decimal
  area      String
  detail    String
  isDefault Boolean @default(false)

  orders Order[]

  @@index([userId])
  @@map("addresses")
}

model Shop {
  id             String     @id @default(uuid())
  ownerUserId    String     @unique
  owner          User       @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  logoUrl        String?
  latitude       Decimal
  longitude      Decimal
  status         ShopStatus @default(PENDING)
  commissionRate Decimal    @default(0.10)
  approvedAt     DateTime?
  createdAt      DateTime   @default(now())

  products ShopProduct[]
  orders   Order[]

  @@index([status])
  @@map("shops")
}

model Category {
  id       String     @id @default(uuid())
  name     String
  parentId String?
  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")

  products Product[]

  @@map("categories")
}

model Product {
  id         String   @id @default(uuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])
  name       String
  unit       String
  imageUrl   String?
  createdAt  DateTime @default(now())

  shopProducts ShopProduct[]

  @@index([categoryId])
  @@map("products")
}

model ShopProduct {
  id            String   @id @default(uuid())
  shopId        String
  shop          Shop     @relation(fields: [shopId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id])
  price         Decimal
  stockQuantity Int      @default(0)
  isAvailable   Boolean  @default(true)
  updatedAt     DateTime @updatedAt

  orderItems OrderItem[]
  cartItems  CartItem[]

  @@unique([shopId, productId])
  @@index([shopId, isAvailable])
  @@map("shop_products")
}

model Cart {
  id         String   @id @default(uuid())
  customerId String   @unique
  shopId     String?
  createdAt  DateTime @default(now())

  items CartItem[]

  @@map("carts")
}

model CartItem {
  id            String      @id @default(uuid())
  cartId        String
  cart          Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  shopProductId String
  shopProduct   ShopProduct @relation(fields: [shopProductId], references: [id])
  quantity      Int

  @@unique([cartId, shopProductId])
  @@map("cart_items")
}

model Order {
  id               String      @id @default(uuid())
  customerId       String
  customer         User        @relation("CustomerOrders", fields: [customerId], references: [id])
  shopId           String
  shop             Shop        @relation(fields: [shopId], references: [id])
  addressId        String
  address          Address     @relation(fields: [addressId], references: [id])
  status           OrderStatus @default(PENDING_PAYMENT)
  itemsSubtotal    Decimal
  deliveryFee      Decimal
  commissionAmount Decimal
  totalAmount      Decimal
  createdAt        DateTime    @default(now())

  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payment            Payment?
  deliveryAssignment DeliveryAssignment?
  review             Review?

  @@index([customerId])
  @@index([shopId])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id                  String      @id @default(uuid())
  orderId             String
  order               Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  shopProductId       String
  shopProduct         ShopProduct @relation(fields: [shopProductId], references: [id])
  productNameSnapshot String
  unitPriceSnapshot   Decimal
  quantity            Int
  lineTotal           Decimal

  @@map("order_items")
}

model OrderStatusHistory {
  id              String       @id @default(uuid())
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  fromStatus      OrderStatus?
  toStatus        OrderStatus
  changedByUserId String?
  changedByUser   User?        @relation(fields: [changedByUserId], references: [id])
  changedAt       DateTime     @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

model RiderProfile {
  id                 String                  @id @default(uuid())
  userId             String                  @unique
  user               User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  vehicleType        String
  licenseNumber      String
  verificationStatus RiderVerificationStatus @default(PENDING)
  isOnline           Boolean                 @default(false)
  currentLat         Decimal?
  currentLng         Decimal?
  ratingAvg          Decimal                 @default(0)
  createdAt          DateTime                @default(now())

  deliveryAssignments DeliveryAssignment[]
  deliveryOffers      DeliveryOffer[]

  @@index([isOnline, verificationStatus])
  @@map("rider_profiles")
}

model DeliveryAssignment {
  id          String                   @id @default(uuid())
  orderId     String                   @unique
  order       Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  riderId     String?
  rider       RiderProfile?            @relation(fields: [riderId], references: [id])
  status      DeliveryAssignmentStatus @default(OFFERING)
  assignedAt  DateTime?
  pickedUpAt  DateTime?
  deliveredAt DateTime?

  offers DeliveryOffer[]

  @@index([riderId])
  @@index([status])
  @@map("delivery_assignments")
}

model DeliveryOffer {
  id                   String              @id @default(uuid())
  deliveryAssignmentId String
  deliveryAssignment   DeliveryAssignment  @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Cascade)
  riderId              String
  rider                RiderProfile        @relation(fields: [riderId], references: [id])
  status               DeliveryOfferStatus @default(PENDING)
  offeredAt            DateTime            @default(now())
  expiresAt            DateTime
  respondedAt          DateTime?

  @@index([riderId])
  @@index([deliveryAssignmentId])
  @@map("delivery_offers")
}

model Payment {
  id                String        @id @default(uuid())
  orderId           String        @unique
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method            PaymentMethod @default(COD)
  status            PaymentStatus @default(PENDING)
  amount            Decimal
  providerReference String?
  paidAt            DateTime?

  refunds Refund[]

  @@map("payments")
}

model Refund {
  id          String       @id @default(uuid())
  paymentId   String
  payment     Payment      @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  amount      Decimal
  reason      String
  status      RefundStatus @default(PENDING)
  processedAt DateTime?

  @@map("refunds")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, isRead])
  @@map("notifications")
}

model Review {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerId String
  customer   User     @relation(fields: [customerId], references: [id])
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  @@map("reviews")
}